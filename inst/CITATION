citHeader("To cite kernR in publications, please use:")

## Read the package version safely. During R CMD check the CITATION file is
## evaluated before the package is installed, so packageVersion() can fail
## with "there is no package called 'kernR'". Fall back to reading the
## DESCRIPTION shipped with the source.
.kernR_version <- tryCatch(
  format(utils::packageVersion("kernR")),
  error = function(e) {
    desc <- system.file("DESCRIPTION", package = "kernR")
    if (!nzchar(desc)) desc <- "DESCRIPTION"
    if (file.exists(desc)) {
      v <- read.dcf(desc, fields = "Version")[1, 1]
      if (!is.na(v)) return(v)
    }
    "unreleased"
  }
)

