Package: kernR
Title: Kernel-Based Causal Distributional Testing
Version: 0.1.0
Authors@R: c(
    person("Max", "Moldovan", , "max.moldovan@gmail.com",
           role = c("aut", "cre"),
           comment = c(ORCID = "0000-0001-9680-8474")),
    person("Dino", "Sejdinovic", , "dino.sejdinovic@adelaide.edu.au",
           role = "aut",
           comment = c(ORCID = "0000-0001-5547-9213"))
